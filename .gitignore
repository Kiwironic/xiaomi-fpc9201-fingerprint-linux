# Compiled / build output
build/
*.o
*.so
*.a
__pycache__/
*.pyc

# Editors
*.swp
*~
.vscode/
.idea/
# Office-suite lock files - these embed the local username and hostname
.~lock.*#

# Local logs and scratch
*.log
/tmp/

# Secrets - never commit tokens or credentials
.config/
*.secret

# Packaging build artifacts
packaging/rpm/*.src.rpm
packaging/rpm/*.tar.gz
