                 return get_uid();
-            case "EnrollStop"_hash:
             case "EnrollStart"_hash:
-            case "VerifyStop"_hash:
-            case "VerifyStart"_hash:
             case "DeleteEnrolledFinger"_hash:
+            case "DeleteEnrolledFingers"_hash:
             case "DeleteEnrolledFingers2"_hash:
+                return check_polkit();
+            case "EnrollStop"_hash:
+            case "VerifyStop"_hash:
+            case "VerifyStart"_hash:
             case "Release"_hash:
                 return check_sender();
             default: break;
